+    /**
+     * Returns how many contacts a campaign in the category with alias "daily-limit" may take now, or null for other campaigns.
+     * It is 0 when the first email cannot go on the day, or before the end of the hours, a new contact would get it.
+     */
+    private function remainingDailyEntries(): ?int
+    {
+        $limit    = (int) $this->coreParametersHelper->get('campaign_daily_entry_limit');
+        $category = $this->campaign->getCategory();
+        if ($limit <= 0 || !$category || 'daily-limit' !== $category->getAlias()) {
+            return null;
+        }
+
+        // Days and hours are read in the default time zone.
+        $now         = new \DateTime('now', new \DateTimeZone($this->coreParametersHelper->getDefaultTimezone()));
+        $firstEmails = $this->findFirstEmails($this->campaign->getRootEvents(), $now);
+        $sendAt      = null;
+        $emailIds    = [];
+        foreach ($firstEmails as [$event, $runAt]) {
+            $emailIds[] = (int) $event->getId();
+            if ($this->canRunAt($event, $runAt) && (null === $sendAt || $runAt < $sendAt)) {
+                $sendAt = $runAt;
+            }
+        }
+
+        if ($emailIds && null === $sendAt) {
+            return 0;
+        }
+
+        // The larger of: contacts added today, and contacts due a first email on the send day.
+        $used = (int) $this->connection->fetchOne(
+            'SELECT COUNT(*) FROM '.MAUTIC_TABLE_PREFIX.'campaign_leads WHERE campaign_id = ? AND date_added >= ?',
+            [$this->campaign->getId(), $this->toUtc((clone $now)->setTime(0, 0))]
+        );
+        if ($emailIds) {
+            $used = max($used, $this->countDueFirstEmail($emailIds, $sendAt, $now));
+        }
+
+        return max(0, $limit - $used);
+    }
+
+    /**
+     * Returns the first email step on each path, with the time a contact joining now reaches it after the waits.
+     *
+     * @param iterable<Event> $events
+     *
+     * @return array<array{Event, \DateTime}>
+     */
+    private function findFirstEmails(iterable $events, \DateTime $from): array
+    {
+        $found = [];
+        foreach ($events as $event) {
+            if ($event->getDeleted()) {
+                continue;
+            }
+
+            $runAt = clone $from;
+            if (Event::TRIGGER_MODE_INTERVAL === $event->getTriggerMode() && $event->getTriggerInterval()) {
+                $runAt->add((new DateTimeHelper())->buildInterval($event->getTriggerInterval(), $event->getTriggerIntervalUnit()));
+            } elseif (Event::TRIGGER_MODE_DATE === $event->getTriggerMode() && $event->getTriggerDate() > $runAt) {
+                $runAt = \DateTime::createFromInterface($event->getTriggerDate())->setTimezone($from->getTimezone());
+            }
+
+            if ('email.send' === $event->getType()) {
+                $found[] = [$event, $runAt];
+            } elseif (Event::TYPE_DECISION !== $event->getEventType()) {
+                $found = array_merge($found, $this->findFirstEmails($event->getChildren(), $runAt));
+            }
+        }
+
+        return $found;
+    }
+
+    /**
+     * Whether the step's days and hours let it run on the given day, at or after the given time.
+     */
+    private function canRunAt(Event $event, \DateTime $runAt): bool
+    {
+        if (Event::TRIGGER_MODE_DATE === $event->getTriggerMode()) {
+            return true;
+        }
+
+        $days = array_map('intval', $event->getTriggerRestrictedDaysOfWeek());
+        if ($days && !in_array((int) $runAt->format('w'), $days, true)) {
+            return false;
+        }
+
+        $start = $event->getTriggerRestrictedStartHour();
+        $stop  = $event->getTriggerRestrictedStopHour();
+
+        return $event->getTriggerHour() || !$start || !$stop || $runAt->format('H:i') < max($start->format('H:i'), $stop->format('H:i'));
+    }
+
+    /**
+     * Counts contacts sent a first email, due one or not yet started, for the day of the send time.
+     *
+     * @param int[] $emailIds
+     */
+    private function countDueFirstEmail(array $emailIds, \DateTime $sendAt, \DateTime $now): int
+    {
+        $dayStart = (clone $sendAt)->setTime(0, 0);
+        $dayEnd   = (clone $dayStart)->modify('+1 day');
+        $log      = MAUTIC_TABLE_PREFIX.'campaign_lead_event_log';
+
+        return (int) $this->connection->executeQuery(
+            'SELECT COUNT(DISTINCT cl.lead_id) FROM '.MAUTIC_TABLE_PREFIX.'campaign_leads cl'
+            .' LEFT JOIN '.$log.' l ON l.campaign_id = cl.campaign_id AND l.lead_id = cl.lead_id AND l.event_id IN (:events)'
+            .' WHERE cl.campaign_id = :campaign AND ('
+            .' (l.is_scheduled = 0 AND l.date_triggered >= :dayStart AND l.date_triggered < :dayEnd)'
+            .' OR (cl.manually_removed = 0 AND l.is_scheduled = 1 AND l.trigger_date < :dayEnd AND (l.trigger_date >= :dayStart OR l.trigger_date <= :now))'
+            .' OR (cl.manually_removed = 0 AND NOT EXISTS (SELECT 1 FROM '.$log.' a WHERE a.campaign_id = cl.campaign_id AND a.lead_id = cl.lead_id))'
+            .' )',
+            [
+                'events'   => $emailIds,
+                'campaign' => $this->campaign->getId(),
+                'dayStart' => $this->toUtc($dayStart),
+                'dayEnd'   => $this->toUtc($dayEnd),
+                'now'      => $this->toUtc($now),
+            ],
+            ['events' => ArrayParameterType::INTEGER]
+        )->fetchOne();
+    }
+
+    private function toUtc(\DateTime $date): string
+    {
+        return (clone $date)->setTimezone(new \DateTimeZone('UTC'))->format('Y-m-d H:i:s');
+    }
