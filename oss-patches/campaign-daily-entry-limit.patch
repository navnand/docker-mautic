+    /**
+     * Returns how many more contacts a campaign with a daily limit may take in the last 24 hours, or null without one.
+     * A campaign has the limit when it is chosen in the configuration or is in the campaign category with alias "daily-limit".
+     */
+    private function remainingDailyEntries(): ?int
+    {
+        $limit     = (int) $this->coreParametersHelper->get('campaign_daily_entry_limit');
+        $campaigns = array_map('intval', (array) $this->coreParametersHelper->get('campaign_daily_entry_campaigns', []));
+        $category  = $this->campaign->getCategory();
+        $limited   = in_array((int) $this->campaign->getId(), $campaigns, true)
+            || ($category && 'daily-limit' === $category->getAlias());
+        if ($limit <= 0 || !$limited) {
+            return null;
+        }
+
+        $added = (int) $this->connection->fetchOne(
+            'SELECT COUNT(*) FROM '.MAUTIC_TABLE_PREFIX.'campaign_leads WHERE campaign_id = ? AND date_added >= ?',
+            [$this->campaign->getId(), (new \DateTime('-24 hours', new \DateTimeZone('UTC')))->format('Y-m-d H:i:s')]
+        );
+
+        return max(0, $limit - $added);
     }
 
