+            $unsubscribe = str_replace('|URL|', '{unsubscribe_url}', (string) $this->coreParametersHelper->get('unsubscribe_text'));
+            $this->parsePlainText(str_replace('{unsubscribe_text}', $unsubscribe, $customHtml));
