+    /**
+     * Returns MAUTIC_BROADCAST_DAILY_LIMIT minus the segment emails sent in the last 24 hours, or null when the limit is unset.
+     */
+    private function remainingDailyLimit(): ?int
+    {
+        $cap = (int) getenv('MAUTIC_BROADCAST_DAILY_LIMIT');
+        if ($cap <= 0) {
+            return null;
+        }
+
+        $sent = (int) $this->em->getConnection()->fetchOne(
+            'SELECT COUNT(*) FROM '.MAUTIC_TABLE_PREFIX.'email_stats s INNER JOIN '.MAUTIC_TABLE_PREFIX.'emails e ON e.id = s.email_id WHERE e.email_type = ? AND s.date_sent >= ?',
+            ['list', (new \DateTime('-24 hours', new \DateTimeZone('UTC')))->format('Y-m-d H:i:s')]
+        );
+
+        return max(0, $cap - $sent);
+    }
